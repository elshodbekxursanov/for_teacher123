# Bu faylni ".env" nomi bilan nusxalang (backend papkasida) va qiymatlarni to'ldiring.
# .env faylini hech kimga yubormang!

# --- PDF dan masalalarni avtomatik ajratish (Claude API) ---
ANTHROPIC_API_KEY=
# arzon va tez (standart). Kuchliroq: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Payme / Click (kabinetdan olinadi; sinov uchun bo'sh qoldirsa bo'ladi) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=1
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Faqat jangda (serverda) ---
# SECRET_KEY=uzun-tasodifiy-satr
# DEBUG=0
# FRONTEND_URL=https://sizning-domen.uz
